# CARTO Positron basemap key (required for map tiles)
# Copy this file to .env.local and enter your CARTO key.
# VITE_ variables are visible in the browser; restrict permitted origins in CARTO.
VITE_CARTO_API_KEY=your_carto_basemap_key

# FastAPI backend (local development)
VITE_API_BASE_URL=http://localhost:8000
