
# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=do_not_lung
DB_USER=lung_app
DB_PASSWORD=CHANGE_ME

# 관리자 계정 (로컬 개발용)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Admin session cookies: set a random 32+ character secret (never commit actual value)
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Set true on public HTTPS deployments. Keep false for local http:// development only.
ADMIN_COOKIE_SECURE=false
# Comma-separated frontend origins when different from backend URL.
# For production, prefer serving the frontend and /api on the same HTTPS site.
# ADMIN_ALLOWED_ORIGINS=https://your-app.example

# VWorld 주소 API (server-side only): coordinate -> road-name address
VWORLD_API_KEY=

# Verified smoking-area CSV (not nosmoking_zones_*.csv!)
# LUNG_SMOKING_ZONES_CSV=C:\\data\\verified_smoking_zones.csv
